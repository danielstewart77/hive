HIVE_PORT=8710
# Signs built-in session cookies. Empty: a random key is generated once and
# kept in hive.db (shared with the terminal site).
HIVE_SECRET_KEY=
# Sign in through auth-service instead of hive.db: set its URL (or name the
# backend auth-service in HIVE_AUTH_BACKEND) and the bearer its /admin API takes.
AUTH_SERVICE_URL=
AUTH_SERVICE_ADMIN_TOKEN=
# Microsoft sign-in: on when all four are set (docs/sign-in-microsoft-windows.md).
HIVE_MICROSOFT_TENANT_ID=
HIVE_MICROSOFT_CLIENT_ID=
HIVE_MICROSOFT_CLIENT_SECRET=
HIVE_MICROSOFT_REDIRECT_URL=
# Windows domain sign-in (hive.db store only): on when the keytab exists.
HIVE_KERBEROS_KEYTAB=
HIVE_KERBEROS_SPN=
HIVE_KERBEROS_REALM_MAP=
COMMS_BEARER_TOKEN=
# Required for registering a Mind, updating its registry row, and writing
# its default model. Reads use the service token above.
COMMS_ADMIN_BEARER_TOKEN=
LUCENT_BEARER_TOKEN=
# Lets the console read and edit a Mind's soul. Without it the Soul section
# reports 503 rather than failing obscurely. Must match lucent's own value.
LUCENT_SOUL_BEARER_TOKEN=
HIVE_TOOLS_TOKEN=
# Lets a Mind publish to the Design pages. Deliberately its own credential
# with no fallback: every Mind in the hive already holds the two tokens
# above, so either as a fallback would let any Mind — a kid's Windows box
# included — rewrite Daniel's requirements and press Build. Unset means the
# design routes refuse rather than open.
DESIGN_PUSH_TOKEN=

EDGE_COMMS_URL=http://hive-host:8426
EDGE_LUCENT_URL=http://hive-host:8425
# Replace hive-host with this machine's LAN address or hostname. Until you do,
# the console will not offer a Hive Tools link, because the placeholder opens a
# dead tab. This is also the address the Capability Nodes card links to.
EDGE_HIVE_TOOLS_URL=http://hive-host:9421

OLLAMA_URL=
PIHOLE_URL=
EDGE_MIND_NAMES=
EDGE_MIND_PROFILES=

HIVE_MIND_DIR=/home/daniel/Storage/Dev/hive_mind
HIVE_MIND_PROJECT_PATH=/home/daniel/Storage/Dev/hive_mind
# Left unset on purpose: hive-tools then lands in ./capabilities/hive-tools
# inside this checkout, which resolves on any host without editing a path. Set
# it to an absolute path to clone somewhere else, and recreate the container
# (docker compose up -d) — a restart will not pick it up.
# HIVE_TOOLS_DIR=
HIVE_INIT_DIR=/home/daniel/Storage/Dev/hive-init

# The host tree a Mind's project folders may be mounted from. Also mounted
# into this container at /dev_roots (docker-compose.yml), which is what the
# control browses and creates folders in.
HOST_DEV_DIR=/home/daniel/Storage/Dev
# A second mountable root is added here as JSON, one object per root:
# key, label, compose_var (the variable its spec is written with, defined in
# hive_mind's own .env), console_path (its mount in this container) and
# container_root (where its folders appear inside a Mind). Unset means the
# Dev tree above and nothing else.
# MIND_MOUNT_ROOTS=

# Where a Mind's mounts are written and which compose project recreates it.
# Unset means the hive's own stack: hive_mind's minds/<name>/container/
# compose.yaml, brought up by HIVE_MIND_PROJECT_PATH. A containerised Mind
# with its own compose project is named here, as
# {"<mind>": {"fragment": "<path in this container>", "project_path":
# "<host path of its compose project>", "service": "<service name>",
# "env_file": "<path in this container to the .env its variables come from>"}}
# — the fragment has to be mounted read-write for a save to land.
# MIND_COMPOSE_TARGETS=

# The .env files the Settings credentials tab reads and writes, as this
# container sees them: a JSON object of label to path, e.g.
# {"nervous_system": "/env_hive/.env"} for a hive whose services share one
# .env. Unset is this workstation's five files (nervous_system, hive_mind,
# skippy, mordecai, hive_tools under /env_*). A label left out is a file the
# console does not have; each file must be bind-mounted read-write.
# HIVE_ENV_FILES=

# Sentinel triage review API (on the sensor box)
SENTINEL_REVIEW_URL=http://192.168.4.16:8431
SENTINEL_REVIEW_TOKEN=

# ── the one database ──────────────────────────────────────────────────
# Where the access layer's own checkout is, so the image can install it as a
# build context. The repository is private, so a git install inside the build
# would need a credential there.
HIVE_DATA_DIR=/home/daniel/Storage/Dev/hive-data

# The hive's one Postgres, through `hive_data`. Required: the console
# refuses to start without it.
HIVE_DATABASE_URL=postgresql://hive:...@hive-postgres:5432/hive
